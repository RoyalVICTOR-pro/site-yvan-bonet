{
  "name": "site-yvan-bonet",
  "version": "1.0.0",
  "description": "Yvan BONET Website",
  "source": "./src/views/js/index.js",
  "main": "./public/js/bundle.js",
  "targets": {
    "main": false
  },
  "browserslist": "> 0.25%",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch:sass": "node-sass ./src/views/sass/main.scss ./public/css/style.css -w",
    "watch:backoffice-sass": "node-sass ./src/views/sass/main_back.scss ./public/css/style_admin.css -w",
    "devserver": "live-server",
    "start:dev": "NODE_ENV=development nodemon server.js",
    "start": "npm-run-all --parallel start:dev watch:sass watch:backoffice-sass",
    "start:prod": "NODE_ENV=production nodemon server.js",
    "compile:sass": "node-sass sass/main.scss css/style.comp.css",
    "concat:css": "concat -o css/style.concat.css css/icon-font.css css/style.comp.css",
    "prefix:css": "postcss --use autoprefixer -b 'last 10 versions' css/style.concat.css -o css/style.prefix.css",
    "compress:css": "node-sass css/style.prefix.css css/style.css --output-style compressed",
    "debug": "ndb server.js",
    "build": "webpack"
  },
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "@parcel/transformer-sass": "^2.8.3",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "blueimp-md5": "^2.19.0",
    "bootstrap": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "debug": "^4.3.7",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^7.4.3",
    "express": "^4.21.2",
    "express-handlebars": "^8.0.1",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "handlebars": "^4.7.8",
    "hbs": "^4.2.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.16",
    "parcel": "^2.13.3",
    "sequelize": "^6.37.5",
    "slugify": "^1.6.6",
    "validator": "^13.12.0",
    "vee-validate": "^4.14.7",
    "vue": "^3.5.13",
    "vue-loader": "^17.4.2",
    "vue-router": "^4.5.0",
    "vueify": "^9.4.1",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@parcel/transformer-image": "^2.13.3",
    "@parcel/transformer-vue": "^2.13.3",
    "@vue/compiler-sfc": "^3.5.13",
    "autoprefixer": "^10.4.20",
    "concat": "^1.0.3",
    "connect-livereload": "^0.6.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "livereload": "^0.9.3",
    "morgan": "^1.10.0",
    "node-sass": "^9.0.0",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "prettier": "^3.4.2",
    "sequelize-cli": "^6.6.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  },
  "repository": {
    "type": "git",
